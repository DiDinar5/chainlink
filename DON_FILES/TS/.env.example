# Used by CRE CLI for account link/deploy tx signing
CRE_ETH_PRIVATE_KEY=0x...

# Values below are consumed by `cre secrets create ./secrets.production.yaml ...`
SUMSUB_APP_TOKEN_VALUE=...
SUMSUB_SECRET_KEY_VALUE=...

# Optional if you want to pass these as secrets too
# WORLD_ID_APP_ID_VALUE=app_staging_xxx
# WORLD_ID_ACTION_VALUE=your-action
