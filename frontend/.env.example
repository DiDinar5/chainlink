# -----------------------------------------------------------------------------
# PRODUCTION: copy to .env and fill with real values
# -----------------------------------------------------------------------------

# WalletConnect (required) — https://dashboard.reown.com
VITE_WALLET_CONNECT_PROJECT_ID=your_real_id_here
# Or: VITE_WC_PROJECT_ID=...

# Chain and RPC
VITE_CHAIN_ID=11155111
VITE_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
# Or Alchemy: https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Contracts (addresses from deployment / legacy)
VITE_PASS_REGISTRY=0x...
VITE_KYC_BROKER=0x...
VITE_ASSET_REGISTRY=0x...
VITE_ACCESS_PASS=0x...
VITE_CLAIM_DROP=0x...
VITE_POLICY_ID=0
VITE_KYC_LEVEL_NAME=basic-kyc
VITE_CRE_ISSUER=0x...

# World ID — https://developer.worldcoin.org
VITE_WORLD_ID_APP_ID=app_xxxxxxxx
VITE_WORLD_ID_ACTION=verify_user
VITE_WORLD_ID_VERIFICATION_LEVEL=orb
VITE_WORLD_ID_FLAG=2

# Sumsub: token must be fetched from your backend (never expose long-lived token in frontend)
# TODO: backend endpoint that returns short-lived access token for Sumsub WebSDK
# VITE_SUMSUB_ACCESS_TOKEN_ENDPOINT=https://your-backend/api/sumsub-token
